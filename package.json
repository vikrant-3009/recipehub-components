{
  "name": "@vikrantkatoch/recipehub-ui-components",
  "version": "1.0.0",
  "description": "A reusable web component library for Recipe and Meal Planner Project named RecipeHub.",
  "homepage": "https://github.com/stenciljs/component-starter#readme",
  "bugs": {
    "url": "https://github.com/stenciljs/component-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenciljs/component-starter.git"
  },
  "license": "MIT",
  "author": "Vikrant Katoch",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./dist/recipe-ui-components/recipe-ui-components.esm.js",
      "require": "./dist/recipe-ui-components/recipe-ui-components.cjs.js"
    },
    "./custom-elements": {
      "import": "./dist/custom-elements/index.js",
      "types": "./dist/custom-elements/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/custom-elements/*.js",
      "types": "./dist/custom-elements/*.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "main": "dist/index.cjs.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "assertion-error": "^2.0.1",
    "chai": "^6.2.2",
    "confbox": "^0.2.4",
    "convert-source-map": "^2.0.0",
    "detect-libc": "^2.1.2",
    "es-module-lexer": "^2.3.1",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "exsolve": "^1.1.1",
    "fdir": "^6.5.0",
    "jiti": "^2.7.0",
    "lightningcss": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "local-pkg": "^1.2.1",
    "magic-string": "^0.30.21",
    "mlly": "^1.8.2",
    "mrmime": "^2.0.1",
    "nanoid": "^3.3.18",
    "obug": "^2.1.4",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pkg-types": "^2.3.1",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "quansync": "^0.2.11",
    "rolldown": "^1.2.4",
    "siginfo": "^2.0.0",
    "sirv": "^3.0.2",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^4.2.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^1.3.0",
    "tinyglobby": "^0.2.17",
    "tinyrainbow": "^3.1.1",
    "totalist": "^3.0.1",
    "ufo": "^1.6.4",
    "undici-types": "^6.21.0",
    "vite": "^8.2.1",
    "vitest-environment-stencil": "^1.14.0",
    "why-is-node-running": "^2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "module": "dist/index.js",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-ui-components/recipe-ui-components.esm.js"
}
