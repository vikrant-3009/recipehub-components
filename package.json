{
  "name": "@vikrantkatoch/recipehub-ui-components",
  "version": "1.0.3",
  "description": "A reusable web component library for Recipe and Meal Planner Project named RecipeHub.",
  "homepage": "https://github.com/vikrant-3009/recipehub-components#readme",
  "bugs": {
    "url": "https://github.com/vikrant-3009/recipehub-components/issues"
  },
  "repository": {
